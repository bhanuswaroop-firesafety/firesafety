rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images directory: Public read, authenticated users / admin write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default fallback rules
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
